<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Primary Glowing Aurora Wave (Green to Cyan to Blue) -->
    <path
        android:pathData="M22,74 C40,28 62,86 86,34"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="74"
                android:endX="86"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF4ECCA3" android:offset="0.0" />
                <item android:color="#FF7CE7D7" android:offset="0.5" />
                <item android:color="#FF93B5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary Wave (Purple/Teal Glow) -->
    <path
        android:pathData="M26,82 C46,38 68,92 90,44"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="82"
                android:endX="90"
                android:endY="44"
                android:type="linear">
                <item android:color="#CCB38CFF" android:offset="0.0" />
                <item android:color="#EE7CE7D7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star Glow Backing -->
    <path android:pathData="M78,32 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="78"
                android:centerY="32"
                android:gradientRadius="8"
                android:type="radial">
                <item android:color="#80FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diamond Star Spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M78,24 Q78,32 86,32 Q78,32 78,40 Q78,32 70,32 Q78,32 78,24 Z" />
</vector>
