<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AuroraLivePaper" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07090F</item>
        <item name="android:colorBackground">#07090F</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090F</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AuroraLivePaper</item>
    </style>
</resources>
